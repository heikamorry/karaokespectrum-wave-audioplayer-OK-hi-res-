{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "qt-release",
      "displayName": "Qt Release",
      "description": "Set QTDIR to your Qt installation and initialize your compiler environment before configuring.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/qt-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_PREFIX_PATH": "$env{QTDIR}",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/dist",
        "BUILD_TESTING": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "qt-release",
      "configurePreset": "qt-release"
    }
  ],
  "testPresets": [
    {
      "name": "qt-release",
      "configurePreset": "qt-release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
